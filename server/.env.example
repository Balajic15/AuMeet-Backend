NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (Angular dev server by default)
CORS_ORIGINS=http://localhost:4200

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meetmind

# JWT – use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# LiveKit Cloud (https://cloud.livekit.io) → Settings → Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web app origin (OAuth returns here) and the public origin serving /api.
# In dev the Angular proxy serves /api on :4200, so both are :4200.
WEB_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:4200

# Optional social sign-in. A provider's button works only when both values are set.
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
#   Authorized redirect URI: http://localhost:4200/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:4200/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match AGENT_NAME in agent/.env
AGENT_NAME=aumeet

# ----- Background worker (`npm run worker`) and "Ask your meetings" -----
# Redis for BullMQ, e.g. redis://localhost:6379 (Docker: `docker run -p 6379:6379 redis:7`)
REDIS_URL=redis://localhost:6379
# Google AI Studio key – recaps, embeddings and answers. Same key as agent/.env is fine.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Must match agent/.env so the agent can search the same memory.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# ----- Email (password reset, invitations) -----
# Any SMTP provider, e.g. Resend: smtps://resend:<API_KEY>@smtp.resend.com:465
# Without it, emails are printed to the server log in development (and skipped in production).
SMTP_URL=
MAIL_FROM=AuMeet <no-reply@your-domain.com>

# ----- Privacy & scale -----
# Delete transcripts, notes and memory older than N days (0 = keep). Runs daily in the worker.
DATA_RETENTION_DAYS=0
# How often the worker looks for finished meetings to recap (seconds).
MEMORY_SWEEP_SECONDS=300
# Optional: Atlas Vector Search index name on memory_chunks (see server/README.md).
MEMORY_VECTOR_INDEX=
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ----- Accounts -----
# true = people must confirm their email before creating meetings or sending invites
REQUIRE_EMAIL_VERIFICATION=false

# ----- Recording (optional) – LiveKit Egress uploads MP4s to S3-compatible storage -----
# AWS S3: set bucket/region/keys. Cloudflare R2 / MinIO: also set the endpoint
# (R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"; MinIO: force path style).
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=us-east-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false
