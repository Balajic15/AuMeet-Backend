# LiveKit Cloud – same project/keys as server/.env
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match AGENT_NAME in server/.env (defaults to "aumeet" in both)
AGENT_NAME=aumeet

# Speech-to-text: https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=
# Reasoning: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Voice: https://play.cartesia.ai → API Keys. Voice id from the Cartesia voice library
# (pick one marked multilingual so non-English replies sound natural).
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6

# Optional: store transcripts so later steps (decisions, tasks, memory) can use them.
# Use the same database as the server.
MONGODB_URI=

# Must match server/.env (memory search compares embeddings from the same model)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
